local queue_on_teleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)

if queue_on_teleport then
    queue_on_teleport([[
        repeat task.wait() until game:IsLoaded()
        task.wait(5)
        loadstring(game:HttpGet("https://raw.githubusercontent.com/RetasIsHere/Roblox/refs/heads/main/farm4"))()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/RetasIsHere/Roblox/refs/heads/main/lobby1"))()
    ]])
end

task.spawn(function()
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/RetasIsHere/Roblox/refs/heads/main/farm4"))()
    end)
end)

task.spawn(function()
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/RetasIsHere/Roblox/refs/heads/main/lobby1"))()
    end)
end)
